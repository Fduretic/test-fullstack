{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "web": {
      "projectType": "application", "root": "apps/web", "sourceRoot": "apps/web/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web", "index": "apps/web/src/index.html",
            "browser": "apps/web/src/main.ts", "tsConfig": "apps/web/tsconfig.json",
            "styles": ["apps/web/src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "apps/web/public" }]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "650kB", "maximumError": "900kB" }] },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "web:build:development" } }
      }
    }
  }
}
